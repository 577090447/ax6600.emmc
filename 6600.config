# ==================== 平台目标配置 ====================
CONFIG_TARGET_qualcommax=y                     # 启用高通AX系列平台架构
CONFIG_TARGET_qualcommax_ipq60xx=y             # 具体选择IPQ60xx芯片组平台
CONFIG_TARGET_MULTI_PROFILE=y                  # 启用多设备编译模式，一次生成多个设备固件

# ==================== 设备型号选择 ====================
# 注意：以下所有设备都基于Qualcomm IPQ60xx芯片平台
# 格式：CONFIG_TARGET_DEVICE_<平台>_<芯片>_DEVICE_<品牌>_<型号>=y

# -------- 消费级/家用路由器 --------
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_alfa-network_ap120c-ax=n      # Alfa Network AP120C-AX (开发板/工业级)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_anysafe_e1=n                  # Anysafe E1 (网络安全设备)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cambiumnetworks_xe3-4=n       # Cambium Networks XE3-4 (企业级AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_cmiot_ax18=n                  # 中国移动 CMIOT AX18 (运营商定制版)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-ax1800=n            # GL.iNet GL-AX1800 (开源友好型号)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_glinet_gl-axt1800=n           # GL.iNet GL-AXT1800 (支持三频)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y            # 京东云无线宝 RE-CS-02 (需特殊解锁)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-07=n            # 京东云无线宝 RE-CS-07 (需特殊解锁)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=n          # 京东云无线宝 RE-SS-01 (需特殊解锁)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_kt_ar06-012h=n                # 韩国电信 KT AR06-012H (运营商定制)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_lg_gapd-7500=n                # LG GAPD-7500 (韩国LG U+定制)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v1=n              # Link NN6000 V1 (运营商定制)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=n              # Link NN6000 V2 (运营商定制)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_linksys_mr7350=n              # Linksys MR7350 (Velop系列)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_linksys_mr7500=n              # Linksys MR7500 (Velop系列)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_netgear_wax214=n              # NETGEAR WAX214 (企业级WiFi6 AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_netgear_wax610=n              # NETGEAR WAX610 (企业级WiFi6 AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_netgear_wax610y=n             # NETGEAR WAX610Y (企业级WiFi6 AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_360v6=n                 # 360安全路由 V6 (360 V6)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5=n                   # Redmi AX5 (红米AX5标准版)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi_ax5-jdcloud=n           # Redmi AX5 京东云版 (内置128GB存储)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_tplink_eap610od=n             # TP-Link EAP610-Outdoor (室外AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_tplink_eap623od-hd-v1=n       # TP-Link EAP623HD-Outdoor v1 (室外AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_tplink_eap625od-hd-v1=n       # TP-Link EAP625HD-Outdoor v1 (室外AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_xiaomi_ax1800=n               # 小米 AX1800 (Mi AX1800)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_yuncore_fap650=n              # YunCore FAP650 (企业级AP)
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=n                      # ZN M2 (兆能)

# ==================== 设备特定包配置 ====================
# 为京东云 RE-CS-02 设备特别添加的软件包
#CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02="luci-app-athena-led luci-i18n-athena-led-zh-cn"
# 说明：京东云设备需要特殊的LED控制应用，以正确控制设备指示灯

# ==================== 内核和驱动配置 ====================
CONFIG_ATH11K_MEM_PROFILE_512M=y               # ath11k WiFi驱动内存配置为512MB模式
                                                # 适用于大多数IPQ60xx设备（内存为512MB）
                                                
CONFIG_NSS_FIRMWARE_VERSION_11_4=y             # 使用NSS（网络子系统）固件版本11.4
                                                # NSS用于硬件加速网络转发

# ==================== 软件包配置 ====================
#CONFIG_PACKAGE_luci-app-athena-led=n           # 雅典娜主题LED控制应用（编译为模块）
                                                # =m 表示编译为独立模块，不内置到固件
                                                
#CONFIG_PACKAGE_luci-i18n-athena-led-zh-cn=n    # LED控制应用的中文语言包（编译为模块）
                                                # 用户可在刷机后通过opkg install安装

# ==================== 编译说明 ====================
# 1. 启用 MULTI_PROFILE 后，编译时会为所有标记为 y 的设备生成固件

### 通用配置文件 ###
# 此部分包含编译配置、优化选项和基础软件包
CONFIG_DEVEL=y # 启用开发者模式，显示更多编译选项
CONFIG_TARGET_OPTIONS=y # 启用目标平台选项配置
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv8-a+crypto+crc -mcpu=cortex-a53+crypto+crc -mtune=cortex-a53" # ARM架构优化参数
CONFIG_CCACHE=y # 启用编译缓存，加速后续编译
CONFIG_PACKAGE_default-settings=y # 包含默认设置
CONFIG_PACKAGE_default-settings-chn=y # 包含中国区默认设置（时区、源等）
CONFIG_TARGET_PER_DEVICE_ROOTFS=y # 为每个设备生成独立的rootfs
CONFIG_LUCI_LANG_zh_Hant=n # 不包含繁体中文语言支持

# NSS 软件源（IPQ60xx NSS 加速必需）
CONFIG_FEED_nss_packages=y
CONFIG_FEED_sqm_scripts_nss=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

### USB驱动支持 ###
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-ohci=n
CONFIG_PACKAGE_kmod-usb-uhci=n
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-xhci=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
# CONFIG_PACKAGE_kmod-fs-ntfs is not set # 25.12/kernel 6.12 已移除旧 NTFS 驱动，改用 ntfs-3g 或 ext4
CONFIG_PACKAGE_kmod-fs-ntfs3=n # 未来如需内核 NTFS3 再开

### ZRAM内存压缩交换 ###
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 系统工具软件包 ###
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_dmesg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_btop=n
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_tune2fs=n
CONFIG_PACKAGE_fstrim=n
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_coremark=y
CONFIG_PACKAGE_hdparm=n
CONFIG_PACKAGE_smartmontools-drivedb=n
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=n
CONFIG_PACKAGE_openssh-sftp-server=n
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_chrony=y # NTP 客户端（OAF 时间规则依赖正确时间）
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_luci-app-unblockneteasemusic=n
CONFIG_PACKAGE_luci-app-ddns-go=n
CONFIG_PACKAGE_luci-app-zerotier=y

CONFIG_PACKAGE_luci-app-homeproxy=n
CONFIG_PACKAGE_luci-app-nikki=n
CONFIG_PACKAGE_luci-app-momo=n

### Luci主题和应用 ###
#CONFIG_PACKAGE_luci-theme-aurora=n # 非官方维护，25.12 下若编译失败可忽略或移除
#CONFIG_PACKAGE_luci-app-aurora-config=n
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=n
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wolplus=n
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-vlmcsd=n
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-app-wifischedule=n
CONFIG_PACKAGE_luci-app-uhttpd=n
CONFIG_PACKAGE_luci-app-frps=n
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-hd-idle=n
CONFIG_PACKAGE_luci-app-banip=n
CONFIG_PACKAGE_luci-app-acme=n
CONFIG_PACKAGE_luci-app-arpbind=y
CONFIG_PACKAGE_luci-app-usb-printer=n


### SQM QoS（NSS 加速版，必须开 luci-app-sqm 才能网页配置）###
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_luci-app-wechatpush=n
CONFIG_PACKAGE_luci-app-watchcat=n
# CONFIG_PACKAGE_luci-app-3cat is not set # 卫星插件，路由器无用
# CONFIG_PACKAGE_luci-app-smartdns is not set

### 集客 AC 控制器（需配合集客 AP 7.6+ 固件，建议 8.x）###
CONFIG_PACKAGE_gecoosac=y # 集客软 AC 后端守护进程（必须，否则管理页无法启动）
CONFIG_PACKAGE_luci-app-gecoosac=y # 集客 AC LuCI 网页界面（JS 增强版，适配 25.12 / LuCI 24.x）
CONFIG_PACKAGE_luci-i18n-gecoosac-zh-cn=y # 集客 AC 中文语言包
CONFIG_PACKAGE_coreutils-nohup=y # nohup 依赖（gecoosac 后台运行必需）

# ---------- iStore ----------
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_curl=y
# ---------- Harbor File ----------
CONFIG_PACKAGE_luci-app-harbor-file=y
CONFIG_PACKAGE_luci-i18n-harbor-file-zh-cn=y

### 无线固件（雅典娜 QCN9074 / IPQ6010）###
CONFIG_PACKAGE_ath11k-firmware-ipq6010=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
